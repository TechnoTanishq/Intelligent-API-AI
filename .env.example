# ============================================================
# IntelliAPI AI - Environment configuration
# Copy this file to ".env" and adjust values as needed.
# ============================================================

# --- Backend server ---
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Logging ---
LOG_LEVEL=INFO

# --- Model artifacts (relative to backend/) ---
MODEL_DIR=artifacts
PRIMARY_MODEL=pipeline_rf.joblib
BASELINE_MODEL=pipeline_dt.joblib
METRICS_FILE=metrics.json
CONFIG_FILE=training_config.json

# --- Intelligent agent decision policy (attack probability thresholds) ---
# ALLOW  if attack_probability < RISK_LOW_MAX
# MONITOR if RISK_LOW_MAX <= attack_probability < RISK_HIGH_MIN
# BLOCK  if attack_probability >= RISK_HIGH_MIN
RISK_LOW_MAX=0.35
RISK_HIGH_MIN=0.70

# --- Heuristic toggle (1 enables the separate heuristic layer) ---
ENABLE_HEURISTICS=1

# --- Event store limits ---
MAX_EVENTS_STORED=2000

# --- Dataset path (used by training scripts) ---
CSIC_CSV_PATH=../../csic_database.csv~1/csic_database.csv

# --- Storage backend ---
# "memory" = in-memory event store (default). "mongo" = MongoDB Atlas.
STORAGE_BACKEND=memory

# --- MongoDB Atlas (only used when STORAGE_BACKEND=mongo) ---
# Paste your MongoDB Atlas connection string here. Placeholder only.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=intelliapi_ai
MONGO_COLLECTION=events
