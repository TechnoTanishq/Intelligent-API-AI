# Normalize line endings for cross-platform teams (Windows / Mac / Linux)
* text=auto

# Force Unix line endings for Python and JS source files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.env   text eol=lf

# Binary files — no line-ending conversion
*.joblib binary
*.pkl    binary
*.png    binary
*.jpg    binary
*.ico    binary
